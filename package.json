{
  "name": "dotsnap",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "wxt",
    "build": "npm run icons && wxt build",
    "zip": "npm run icons && wxt zip",
    "lint": "eslint . && prettier --check .",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/verify-browser.mjs",
    "build:test": "node scripts/build-test.mjs",
    "test:m1": "node scripts/build-test.mjs && node scripts/verify-m1.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "format": "prettier --write .",
    "postinstall": "wxt prepare",
    "test:m2": "node scripts/build-test.mjs && node scripts/verify-m2.mjs",
    "test:m3": "node scripts/build-test.mjs && node scripts/verify-m3.mjs"
  },
  "dependencies": {
    "konva": "10.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  }
}
